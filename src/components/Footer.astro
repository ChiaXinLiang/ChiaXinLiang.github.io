---
import { GITHUB_URL, LINKEDIN_URL } from '../consts';
const today = new Date();
---

<footer>
	<div>
		&copy; {today.getFullYear()} Xin Liang Chia ·{' '}
		<a href={GITHUB_URL} target="_blank">GitHub</a> ·{' '}
		<a href={LINKEDIN_URL} target="_blank">LinkedIn</a> ·{' '}
		<a href="/rss.xml">RSS</a>
	</div>
	<div class="tag">Notes on LLMs and the systems that run them.</div>
</footer>

<style>
	footer {
		padding: 2em 1em 4em;
		background: linear-gradient(rgba(var(--gray-light), 50%), var(--bg));
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	footer a {
		color: rgb(var(--gray-dark));
	}
	.tag {
		margin-top: 0.5em;
		font-size: 0.85em;
	}
</style>
