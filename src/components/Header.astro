---
import { SITE_TITLE, GITHUB_URL, LINKEDIN_URL } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header data-site-header>
	<nav aria-label="Main navigation">
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/roadmap">Roadmap</HeaderLink>
			<HeaderLink href="/blog">Blogs</HeaderLink>
			<HeaderLink href="/posts">Posts</HeaderLink>
			<HeaderLink href="/about">About Me</HeaderLink>
		</div>
		<div class="font-controls" aria-label="Text size">
			<button id="font-dec" title="Smaller text">A−</button>
			<button id="font-inc" title="Larger text">A+</button>
		</div>
		<div class="social-links">
			<a href={GITHUB_URL} target="_blank">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="/rss.xml" title="RSS feed">
				<span class="sr-only">RSS</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="26" height="26"
					><path
						fill="currentColor"
						d="M2 2v2.5c5.247 0 9.5 4.253 9.5 9.5H14C14 7.373 8.627 2 2 2zm0 5v2.5A4.5 4.5 0 0 1 6.5 14H9a7 7 0 0 0-7-7zm1.5 4.5a1.75 1.75 0 1 0 0 3.5 1.75 1.75 0 0 0 0-3.5z"
					></path></svg
				>
			</a>
			<a href={LINKEDIN_URL} target="_blank">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<script is:inline>
	(function () {
		var header = document.querySelector('[data-site-header]');
		if (header) {
			var updateHeight = function () { document.documentElement.style.setProperty('--header-height', header.getBoundingClientRect().height + 'px'); };
			new ResizeObserver(updateHeight).observe(header);
			updateHeight();
		}
		var min = 17, max = 25, def = 21;
		function cur() { return parseInt(localStorage.getItem('baseFont') || def, 10); }
		function apply(v) {
			v = Math.min(max, Math.max(min, v));
			document.documentElement.style.setProperty('--base-font', v + 'px');
			localStorage.setItem('baseFont', v);
		}
		var d = document.getElementById('font-dec'), i = document.getElementById('font-inc');
		if (d) d.addEventListener('click', function () { apply(cur() - 2); });
		if (i) i.addEventListener('click', function () { apply(cur() + 2); });
	})();
</script>
<style>
	header {
		margin: 0;
		padding: 0 24px;
		position: sticky;
		top: 0;
		z-index: 30;
		border-bottom: 1px solid rgb(var(--gray-light));
		font-size: 16px;
		background: var(--bg);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 18px;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		min-height: 64px;
		max-width: 1400px;
		margin: auto;
	}
	nav a {
		padding: 18px 10px;
		white-space: nowrap;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.internal-links { display: flex; align-items: center; min-width: 0; }
	h2 { flex-shrink: 0; }
	h2 a { padding: 0; border: 0; }
	nav a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
	.font-controls {
		display: flex;
		gap: 0.4em;
		align-items: center;
		margin-right: 0.8em;
	}
	.font-controls button {
		font-size: 15px;
		font-weight: 700;
		padding: 0.25em 0.6em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		background: var(--bg);
		color: rgb(var(--gray-dark));
		cursor: pointer;
	}
	.font-controls button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
		align-items: center;
	}
	@media (max-width: 760px) {
        header { padding: 0 16px; }
        nav { flex-wrap: wrap; gap: 0 12px; padding-top: 12px; }
        h2 { font-size: 17px; }
        .font-controls { margin: 0 0 0 auto; }
        .internal-links { order: 3; flex: 0 0 100%; overflow-x: auto; scrollbar-width: thin; }
        .internal-links a { padding: 12px 10px; font-size: 15px; }
    }
	@media (max-width: 900px) {
		.social-links {
			display: none;
		}
	}
</style>
