---
import { Image } from 'astro:assets';
import { SERIES } from '../consts';
import { LEVELS } from '../data/curriculum';
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
const catalog = SERIES.filter(series => posts.some(p => p.data.series === series.id)).map(series => ({
  ...series,
  cover: [...posts].filter(p => p.data.series === series.id && p.data.heroImage).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))[0]?.data.heroImage,
  entries: [
    ...posts.filter(p => p.data.series === series.id).map(p => ({ title: p.data.title, topic: p.data.topic ?? '', code: p.data.code ?? '', tags: p.data.tags ?? [], level: p.data.level, published: true, href: `/blog/${p.id}/` })),
  ],
}));
const catalogTags = [...new Set(catalog.map(series => series.tag))];
const topicTags = [...new Set(catalog.flatMap(series => series.topicTags))].sort();
---
<section class="learning-hub" aria-label="Search and filter series">
  <div class="search-controls">
  <div class="search-control">
    <label for="series-search">Search series and topics</label>
    <input id="series-search" type="search" placeholder="Search networking, CUDA, MLE…" autocomplete="off" />
  </div>
  <div class="topic-control">
    <label for="series-topic">Topic</label>
    <select id="series-topic"><option value="">All topics</option>{topicTags.map(tag => <option value={tag}>{tag}</option>)}</select>
  </div>
  </div>
  <div class="filters">
    <div class="tags" role="group" aria-label="Filter by subject">
      <button type="button" data-tag="" aria-pressed="true">All subjects</button>
      {catalogTags.map(tag => <button type="button" data-tag={tag} aria-pressed="false">{tag}</button>)}
    </div>
    <div class="select-filters">
      <label>Difficulty <select id="series-level"><option value="">All levels</option>{LEVELS.map(l => <option value={l.id}>{l.name}</option>)}</select></label>
      <button class="reset" type="button">Reset</button>
    </div>
  </div>
  <p class="result-count" aria-live="polite" aria-atomic="true">{catalog.length} series</p>
  <div class="series-rows" id="series-results">
    {catalog.map(series => <article class="series-row" data-series={series.id}>
      {series.cover && <a class="series-cover" href={`/series/${series.id}/`} tabindex="-1" aria-hidden="true"><Image src={series.cover} alt="" width={600} height={320} loading="lazy" /></a>}
      <div class="card-content">
      <div class="row-heading"><a href={`/series/${series.id}/`}>{series.name}</a><span class="series-tags"><span class="tag">{series.tag}</span>{series.topicTags.map(tag => <span class="tag">{tag}</span>)}<span class="tag">{series.level}</span></span></div>
      <p class="description">{series.tagline}</p>
      <p class="counts">{series.entries.length} published article{series.entries.length === 1 ? '' : 's'}</p>
      <ul class="matching-articles" hidden></ul>
      </div>
    </article>)}
  </div>
  <button class="view-more" type="button" aria-expanded="false" aria-controls="series-results" hidden>View more</button>
  <p class="empty" hidden>No matching series. Try another search or reset the filters.</p>
  <script type="application/json" class="catalog-data" set:html={JSON.stringify(catalog.map(({ cover, ...series }) => series)).replace(/</g, '\\u003c')} />
</section>
<script>
  interface Entry { title: string; topic: string; code: string; tags: string[]; level: string; published: boolean; href: string; }
  interface Series { id: string; name: string; tagline: string; tag: string; topicTags: string[]; level: string; entries: Entry[]; }
  function initializeCatalog() {
    document.querySelectorAll<HTMLElement>('.learning-hub').forEach(hub => {
      if (hub.dataset.initialized) return;
      hub.dataset.initialized = 'true';
      const catalog: Series[] = JSON.parse(hub.querySelector('.catalog-data')!.textContent!);
      const search = hub.querySelector<HTMLInputElement>('#series-search')!;
      const level = hub.querySelector<HTMLSelectElement>('#series-level')!;
      const topic = hub.querySelector<HTMLSelectElement>('#series-topic')!;
      const buttons = [...hub.querySelectorAll<HTMLButtonElement>('[data-tag]')];
      let tag = '';
      let expanded = false;
      const more = hub.querySelector<HTMLButtonElement>('.view-more')!;
      const initialCount = 4;
      const normalize = (value: string) => value.toLocaleLowerCase().normalize('NFKC').replace(/maximum likelihood estimation/g, 'maximum likelihood estimation mle');
      const update = () => {
        const terms = normalize(search.value.trim()).split(/\s+/).filter(Boolean);
        let visible = 0;
        const filtering = Boolean(terms.length || tag || topic.value || level.value);
        for (const series of catalog) {
          const row = hub.querySelector<HTMLElement>(`[data-series="${series.id}"]`)!;
          const seriesText = normalize(`${series.name} ${series.tagline} ${series.tag} ${series.topicTags.join(' ')} ${series.level}`);
          const entries = series.entries.filter(entry => {
            const text = `${seriesText} ${normalize(`${entry.title} ${entry.topic} ${entry.code} ${entry.tags.join(' ')}`)}`;
            return terms.every(term => text.includes(term));
          });
          row.hidden = Boolean((tag && tag !== series.tag) || (topic.value && !series.topicTags.includes(topic.value)) || (level.value && level.value !== series.level.toLowerCase()) || entries.length === 0);
          if (!row.hidden) {
            visible++;
            if (!filtering && !expanded && visible > initialCount) row.hidden = true;
          }
          const published = entries.filter(p => p.published).length;
          row.querySelector('.counts')!.textContent = `${published} published article${published === 1 ? '' : 's'}${terms.length || level.value ? ' matching' : ''}`;
          const list = row.querySelector<HTMLUListElement>('.matching-articles')!;
          list.replaceChildren();
          list.hidden = !terms.length;
          if (terms.length) {
            for (const entry of entries.slice(0, 3)) {
              const item = document.createElement('li');
              const title = document.createElement('a');
              title.textContent = entry.title;
              title.href = entry.href;
              item.append(title); list.append(item);
            }
            if (entries.length > 3) {
              const item = document.createElement('li');
              const more = document.createElement('a'); more.href = `/series/${series.id}/`; more.textContent = `${entries.length - 3} more matching articles in this series →`; item.append(more); list.append(item);
            }
          }
        }
        const shown = !filtering && !expanded ? Math.min(initialCount, visible) : visible;
        hub.querySelector('.result-count')!.textContent = shown < visible ? `Showing ${shown} of ${visible} series` : `${visible} series${filtering ? (visible === 1 ? ' matches your filters' : ' match your filters') : ''}`;
        more.hidden = filtering || visible <= initialCount;
        more.textContent = expanded ? 'Show less' : `View more (${visible - initialCount})`;
        more.setAttribute('aria-expanded', String(expanded));
        hub.querySelector<HTMLElement>('.empty')!.hidden = visible > 0;
      };
      more.addEventListener('click', () => { expanded = !expanded; update(); });
      search.addEventListener('input', update);
      level.addEventListener('change', update);
      topic.addEventListener('change', update);
      buttons.forEach(button => button.addEventListener('click', () => {
        tag = button.dataset.tag!;
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button))); update();
      }));
      hub.querySelector('.reset')!.addEventListener('click', () => {
        search.value = ''; level.value = ''; topic.value = ''; tag = ''; expanded = false;
        buttons.forEach(b => b.setAttribute('aria-pressed', String(!b.dataset.tag))); update(); search.focus();
      });
      update();
    });
  }
  initializeCatalog(); document.addEventListener('astro:page-load', initializeCatalog);
</script>
<style>
  .learning-hub { margin: 1.5rem 0 2.5rem; }
  .search-controls { display: grid; grid-template-columns: minmax(0, 1fr) minmax(190px, 260px); align-items: end; gap: .75rem; }
  .topic-control select { width: 100%; margin: 0; padding: .9rem .65rem; font-size: .85rem; }
  .search-control label, .topic-control label { display: block; font-size: .8em; margin-bottom: .4rem; color: rgb(var(--gray-dark)); }
  input { width: 100%; box-sizing: border-box; border: 1px solid rgb(var(--gray-light)); border-radius: 8px; padding: .9rem 1rem; font: inherit; background: var(--bg); color: rgb(var(--black)); }
  .filters { margin-top: .85rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; }
  button, select { font: inherit; font-size: .75rem; color: rgb(var(--gray-dark)); background: var(--bg); border: 1px solid rgb(var(--gray-light)); border-radius: 6px; padding: .45rem .65rem; }
  button { cursor: pointer; }
  .tags button { border-radius: 20px; }
  button[aria-pressed="true"] { color: var(--accent); border-color: var(--accent); background: rgba(var(--gray-light), .4); }
  .select-filters { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; margin-top: .75rem; }
  .select-filters label { font-size: .75rem; color: rgb(var(--gray)); }
  select { margin-left: .3rem; }
  .reset { margin-left: auto; }
  .result-count { font-size: .7em; color: rgb(var(--gray)); margin: 1.2rem 0 .5rem; }
  .series-rows { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .series-row { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; overflow: hidden; background: var(--bg); }
  .series-cover { display: block; aspect-ratio: 15 / 8; overflow: hidden; background: #fff; }
  .series-cover img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .card-content { padding: 1rem; }
  .view-more { display: block; margin: 1.25rem auto 0; font-size: .85rem; padding: .65rem 1.2rem; }

  .row-heading { display: block; }
  .row-heading a { font-weight: 700; text-decoration: none; font-size: 1rem; }
  .tag { font-size: .65rem; border: 1px solid rgb(var(--gray-light)); border-radius: 20px; padding: .2rem .5rem; color: rgb(var(--gray)); white-space: nowrap; }
  .series-tags { display: flex; flex-wrap: wrap; gap: .35rem; margin: .6rem 0; }
  .description { font-size: .75em; color: rgb(var(--gray)); margin: .35rem 0; }
  .counts { color: var(--accent); font-size: .65em; margin: .3rem 0 0; }
  .matching-articles { font-size: .75em; margin: .65rem 0 0; padding-left: 1.2rem; }
  .matching-articles li { margin: .4rem 0; }
  .empty { color: rgb(var(--gray)); }
  .empty { font-size: .85em; }
  [hidden] { display: none !important; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media(max-width: 600px) { .search-controls { grid-template-columns: 1fr; } .series-rows { grid-template-columns: 1fr; } .row-heading { display: block; } .tag { display: inline-block; margin-top: .4rem; } .select-filters { gap: .5rem; } .reset { margin-left: 0; } }
</style>
