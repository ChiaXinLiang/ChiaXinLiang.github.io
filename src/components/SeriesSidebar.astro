---
import { getCollection } from 'astro:content';
import { SERIES } from '../consts';
import { LEVELS } from '../data/curriculum';
interface Props { seriesId: string; currentId: string; }
const { seriesId, currentId } = Astro.props;
const series = SERIES.find((item) => item.id === seriesId);
const posts = (await getCollection('blog'))
  .filter((post) => post.data.series === seriesId)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999) || a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
---
{series && (
  <aside class="series-sidebar" aria-label="Series navigation">
    <details class="series-menu" open>
      <summary class="mobile-toggle">Browse this series <span aria-hidden="true">⌄</span></summary>
      <nav aria-label={series.name} class="sidebar-content">
        <a class="series-title" href={`/series/${series.id}/`}>{series.name}</a>
        <p class="series-count">{posts.length} published · by level</p><a class="roadmap-link" href={`/series/${series.id}/`}>Topics and planned articles →</a>
        {LEVELS.map(level => {
          const list = posts.filter(post => post.data.level === level.id);
          return <details class="topic-group" open={list.some(post => post.id === currentId)}>
            <summary>{level.name} <span class="level-count">({list.length})</span></summary>
            {list.length === 0 && <p class="series-count">No published articles at this level yet.</p>}
            {[...new Set(list.map(post => post.data.topic ?? 'Other'))].map(topic => <section><h4>{topic.replace(/^\d+[ -]+/, '')}</h4><ol>{list.filter(post => (post.data.topic ?? 'Other') === topic).map(post => <li>
              <a href={`/blog/${post.id}/`} aria-current={post.id === currentId ? 'page' : undefined}>
                <span class="article-number" aria-hidden="true">{post.data.order}.</span>
                <span>{post.data.title}</span>
              </a>
            </li>)}</ol></section>)}
          </details>;
        })}
        <a class="all-series" href="/blog/">← All series</a>
      </nav>
    </details>
  </aside>
)}
<script>
  const desktop = window.matchMedia('(min-width: 1100px)');
  const menu = document.querySelector<HTMLDetailsElement>('.series-menu');
  const updateMenu = () => { if (menu) menu.open = desktop.matches; };
  updateMenu();
  desktop.addEventListener('change', updateMenu);
</script>
<style>
  .series-sidebar { min-width: 0; font-size: 15px; line-height: 1.5; }
  .series-menu { border: 1px solid rgb(var(--gray-light)); border-radius: 12px; background: var(--bg); }
  .mobile-toggle { cursor: pointer; padding: 1rem; font-weight: 700; color: rgb(var(--black)); }
  .mobile-toggle span { float: right; }
  .sidebar-content { padding: 1.2rem; }
  .series-title { display: block; font-size: 1.1rem; font-weight: 700; text-decoration: none; line-height: 1.3; }
  .series-count { margin: .5rem 0 1rem; color: rgb(var(--gray)); font-size: .85rem; }
  .roadmap-link { display: block; font-size: .8rem; margin: 0 0 1rem; }
  h4 { font-size: .8rem; margin: 1rem 0 .2rem; color: rgb(var(--gray)); font-weight: 400; }
  .level-count { font-weight: 400; color: rgb(var(--gray)); }
  .topic-group { border-top: 1px solid rgb(var(--gray-light)); padding: .65rem 0; }
  .topic-group summary { cursor: pointer; font-weight: 700; color: rgb(var(--black)); }
  ol { list-style: none; margin: .5rem 0 0; padding: 0; }
  li { margin: .2rem 0; }
  li a { display: flex; gap: .5rem; padding: .55rem .6rem; border-radius: 6px; text-decoration: none; color: rgb(var(--gray-dark)); }
  .article-number { flex: 0 0 1.4rem; color: rgb(var(--gray)); font-size: .85em; padding-top: .15em; }
  li a:hover { background: rgba(var(--gray-light), .5); }
  li a[aria-current="page"] { background: rgba(var(--gray-light), .65); color: var(--accent); font-weight: 700; box-shadow: inset 3px 0 var(--accent); }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .all-series { display: inline-block; margin-top: 1rem; font-size: .85rem; }
  @media (min-width: 1100px) {
    .series-sidebar { position: sticky; top: 1.5rem; align-self: start; max-height: calc(100dvh - 3rem); overflow-y: auto; scrollbar-width: thin; }
    .mobile-toggle { display: none; }
  }
</style>
