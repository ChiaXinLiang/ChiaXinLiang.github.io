---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SERIES } from '../../consts';
import { getCollection } from 'astro:content';
export async function getStaticPaths() { const posts = await getCollection('blog'); return SERIES.filter(s => posts.some(p => p.data.series === s.id)).map(s => ({ params: { id: s.id } })); }
const { id } = Astro.params;
const series = SERIES.find(s => s.id === id)!;
const posts = (await getCollection('blog')).filter(p => p.data.series === id);
const total = posts.length;
if (total > 30) throw new Error(`${id} exceeds the 30-article curriculum limit (${total}).`);
const entries = [
  ...posts.map(p => ({ title: p.data.title, topic: p.data.topic ?? 'Other', order: p.data.order ?? 999, href: `/blog/${p.id}/` })),
].sort((a,b) => a.order-b.order);
const topics = [...new Set(entries.map(p => p.topic))];
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={series.name} description={series.tagline} /></head>
  <body>
    <Header />
    <main>
      <p class="crumb"><a href="/blog/">← All series</a></p>
      <h1>{series.name}</h1>
      <div class="tags"><span>{series.tag}</span><span>{series.level}</span></div>
      <p class="tagline">{series.tagline}</p>
      <p class="counts">{posts.length} published article{posts.length === 1 ? '' : 's'}</p>
      {topics.map(topic => <section class="topic"><h2>{topic.replace(/^\d+[ -]+/, '')}</h2><ol>
        {entries.filter(p => p.topic === topic).map(p => <li value={p.order}><a href={p.href}>{p.title}</a></li>)}
      </ol></section>)}
    </main>
    <Footer />
  </body>
</html>
<style>
  .crumb, .counts { font-size: .8em; color: rgb(var(--gray)); }
  h1 { margin: .3em 0; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1rem 0; }
  .tags span { font-size: .7em; border: 1px solid rgb(var(--gray-light)); border-radius: 20px; color: var(--accent); padding: .25rem .65rem; }
  .tagline { color: rgb(var(--gray-dark)); }
  .roadmap { font-size: .85em; color: rgb(var(--gray)); }
  .topic { margin: 2rem 0; }
  h2 { font-size: 1.1em; margin: 1.3rem 0 .5rem; }
  ol { padding-left: 1.6rem; }
  li { margin: .7rem 0; font-size: .9em; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
</style>
