---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SERIES } from '../../consts';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
	return SERIES.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const series = SERIES.find((s) => s.id === id)!;
const posts = (await getCollection('blog'))
	.filter((p) => p.data.series === id)
	.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

// Group by topic, preserving first-seen order
const topics = new Map<string, typeof posts>();
for (const p of posts) {
	const t = p.data.topic ?? 'Other';
	if (!topics.has(t)) topics.set(t, []);
	topics.get(t)!.push(p);
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={series.name} description={series.tagline} />
		<style>
			.level {
				font-size: 0.8em;
				font-weight: 700;
				color: var(--accent);
			}
			.topic h3 {
				margin-bottom: 0.5rem;
			}
			.topic ul {
				list-style: none;
				padding: 0;
				margin: 0 0 2rem;
			}
			.topic li {
				margin-bottom: 0.5rem;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.85em;
				margin-left: 0.5rem;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<span class="level">{series.level}</span>
			<h1>{series.name}</h1>
			<p>{series.tagline}</p>
			{posts.length === 0 && <p class="empty">First articles landing soon — the series is in production.</p>}
			{
				[...topics.entries()].map(([topic, list]) => (
					<section class="topic">
						<h3>{topic}</h3>
						<ul>
							{list.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>
		<Footer />
	</body>
</html>
