---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SERIES } from '../../consts';
import { getCollection } from 'astro:content';
import LearningHub from '../../components/LearningHub.astro';

const all = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const unclassified = all.filter((p) => !p.data.series);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
		<style>

			.notes ul {
				list-style: none;
				padding: 0;
			}
			.notes li {
				margin-bottom: 0.45rem;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.85em;
				margin-left: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			<p>Find a series by searching its title or topics, then filter by subject, topic, and difficulty.</p>
			<p><a href="/roadmap/">Explore the interactive learning roadmap →</a></p>
			<LearningHub posts={all} />
			{
				unclassified.length > 0 && (
					<section class="notes">
						<h2>Notes</h2>
						<ul>
							{unclassified.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
