---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SERIES } from '../../consts';
import { getCollection } from 'astro:content';

const all = (await getCollection('blog')).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf(),
);

// Group a series' posts by topic, preserving first-seen order
function byTopic(seriesId: string) {
	const posts = all.filter((p) => p.data.series === seriesId);
	const topics = new Map<string, typeof posts>();
	for (const p of posts) {
		const t = p.data.topic ?? 'Other';
		if (!topics.has(t)) topics.set(t, []);
		topics.get(t)!.push(p);
	}
	return topics;
}

const unclassified = all.filter((p) => !p.data.series);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Blog" description={SITE_DESCRIPTION} />
		<style>
			.series {
				margin-bottom: 3rem;
				scroll-margin-top: 2rem;
			}
			.series > h2 {
				margin-bottom: 0.25rem;
			}
			.level {
				display: inline-block;
				font-size: 0.75em;
				font-weight: 700;
				color: var(--accent);
			}
			.tagline {
				color: rgb(var(--gray));
				margin: 0.25rem 0 1rem;
			}
			.topic h3 {
				font-size: 1.05em;
				margin: 1rem 0 0.4rem;
			}
			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			li {
				margin-bottom: 0.45rem;
			}
			.date {
				color: rgb(var(--gray));
				font-size: 0.85em;
				margin-left: 0.5rem;
			}
			.empty {
				color: rgb(var(--gray));
				font-style: italic;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Blog</h1>
			{
				SERIES.map((s) => {
					const topics = byTopic(s.id);
					return (
						<section class="series" id={s.id}>
							<h2>{s.name}</h2>
							<span class="level">{s.level}</span>
							<p class="tagline">{s.tagline}</p>
							{topics.size === 0 && <p class="empty">First articles landing soon — this series is in production.</p>}
							{[...topics.entries()].map(([topic, list]) => (
								<div class="topic">
									<h3>{topic}</h3>
									<ul>
										{list.map((post) => (
											<li>
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
												<span class="date">
													<FormattedDate date={post.data.pubDate} />
												</span>
											</li>
										))}
									</ul>
								</div>
							))}
						</section>
					);
				})
			}
			{
				unclassified.length > 0 && (
					<section class="series" id="notes">
						<h2>Notes</h2>
						<p class="tagline">Meta posts and everything that doesn't fit a series.</p>
						<ul>
							{unclassified.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
