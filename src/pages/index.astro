---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, SERIES } from '../consts';
import { getCollection } from 'astro:content';
import LearningHub from '../components/LearningHub.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero h1 {
				background: linear-gradient(90deg, var(--accent), var(--accent-2));
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				color: var(--accent);
			}
			.hero p {
				font-size: 1.15em;
				color: rgb(var(--gray-dark));
			}
			.hero .identity {
				font-weight: 600;
			}

			.latest li {
				margin-bottom: 0.6rem;
			}
			.latest .date {
				color: rgb(var(--gray));
				font-size: 0.85em;
				margin-left: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Notes on making AI work — and work fast</h1>
				<p class="identity">
					Hi, I'm Marcus. I document what I learn about LLMs and the systems that
					run them — one concept at a time, with concrete numbers and original
					diagrams.
				</p>
				<p>
					Learning paths through AI infrastructure, model mathematics, and hardware
					co-design. Search by topic and filter series by subject and level. Primary sources always
					cited. Follow along via <a href="/rss.xml">RSS</a>.
				</p>
			</section>

			<section>
				<h2>Series</h2>
				<LearningHub posts={posts} />
			</section>

			<section class="latest">
				<h2>Latest</h2>
				<ul>
					{
						latest.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
