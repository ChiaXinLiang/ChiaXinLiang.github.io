---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SERIES } from '../consts';
import { getCollection } from 'astro:content';
import { publishedSeriesOrder } from '../lib/published-series';
const posts = await getCollection('blog');
const steps = [
 {id:'llm-basics', before:[], goal:'Understand tokens, learning objectives, attention, and inference.'},
 {id:'fpga-fundamentals', before:[], goal:'Learn FPGA fabric, binary numbers, logic, RTL, simulation, timing, crossings, and AI arithmetic.'},
 {id:'comp-arch', before:[], goal:'Understand instructions, processors, locality, and memory systems.'},
 {id:'ai-performance', before:['comp-arch'], goal:'Build a performance model, profile bottlenecks, and budget capacity.'},
 {id:'llm-architectures', before:['llm-basics'], goal:'Read model configurations and connect structure to state and compute.'},
 {id:'ai-networking', before:['ai-performance'], goal:'Follow communication paths and reason about collective cost and overlap.'},
 {id:'gpu-performance', before:['comp-arch','ai-performance'], goal:'Understand GPU execution, memory access, kernels, and compilation.'},
 {id:'distributed-training', before:['llm-basics','ai-performance','ai-networking','gpu-performance'], goal:'Budget training state, shard work, and preserve progress across failures.'},
 {id:'llm-serving', before:['llm-basics','ai-performance','ai-networking','gpu-performance'], goal:'Combine batching, cache management, scheduling, and production measurement.'},
 {id:'efficient-ml', before:['llm-basics','ai-performance'], goal:'Connect pruning, quantization, distillation, and model design to quality and deployment cost.'},
 {id:'efficient-vision', before:['llm-basics','gpu-performance'], goal:'Understand image tokens, diffusion objectives, sampling, and efficient generation.'},
 {id:'efficient-ai', before:['comp-arch','llm-architectures','gpu-performance'], goal:'Evaluate quantization and algorithm–hardware design tradeoffs.'},
 {id:'fpga-ai-chip', before:['fpga-fundamentals','comp-arch'], goal:'Build and verify a small AI accelerator, then learn the steps toward FPGA deployment and an educational ASIC.'},
].map(step => ({...step, ...SERIES.find(s => s.id === step.id)!, articles:publishedSeriesOrder(posts.filter(p=>p.data.series===step.id)).map(p=>({id:p.id,title:p.data.title,href:`/blog/${p.id}/`}))})).filter(s=>s.articles.length);
const paths = {all:steps.map(s=>s.id),infra:['comp-arch','llm-basics','ai-performance','ai-networking','gpu-performance','distributed-training','llm-serving'],models:['llm-basics','llm-architectures','efficient-ml','efficient-vision','llm-serving'].filter(id=>steps.some(s=>s.id===id)),hardware:['fpga-fundamentals','comp-arch','ai-performance','gpu-performance','llm-architectures','efficient-ai','fpga-ai-chip']};
const stages = [
 {title: 'Stage 1 · Start here', hint: 'No background needed. Pick the side that interests you — models or hardware.', ids: ['llm-basics', 'comp-arch', 'fpga-fundamentals']},
 {title: 'Stage 2 · Core concepts', hint: 'Performance thinking and how modern models are put together.', ids: ['ai-performance', 'llm-architectures']},
 {title: 'Stage 3 · Systems deep dives', hint: 'How data moves between machines and how GPUs execute work.', ids: ['ai-networking', 'gpu-performance']},
 {title: 'Stage 4 · Training & serving at scale', hint: 'Combine everything to train and serve large models in production.', ids: ['distributed-training', 'llm-serving']},
 {title: 'Stage 5 · Efficiency & co-design', hint: 'Make models smaller, faster, and matched to the hardware.', ids: ['efficient-ml', 'efficient-vision', 'efficient-ai']},
 {title: 'Stage 6 · Build an accelerator', hint: 'Apply the separate fundamentals course to verified RTL, FPGA deployment, and educational ASIC implementation.', ids: ['fpga-ai-chip']},
].map(stage => ({...stage, steps: stage.ids.map(id => steps.findIndex(s => s.id === id)).filter(i => i >= 0)})).filter(stage => stage.steps.length);
---
<!doctype html><html lang="en"><head><BaseHead title="Learning Roadmap" description="An interactive learning map through published AI infrastructure articles." /></head><body><Header /><main>
<h1>Learning roadmap</h1><p>Work through the stages from top to bottom. Steps in the same stage are independent — start with either. Select a step to see its articles; steps marked <span class="legend-chip">background</span> are recommended reading before it.</p>
<section class="roadmap" aria-label="Interactive learning roadmap">
<div class="controls"><label for="learning-path">Your learning goal</label><select id="learning-path"><option value="all">Explore everything</option><option value="models">I want to understand how LLMs work</option><option value="infra">I want to train & serve models at scale</option><option value="hardware">I want to go deep on GPUs & chips</option></select></div>
<p class="path-order" aria-live="polite"></p>
<div class="map">
{stages.map(stage=><section class="stage"><h3>{stage.title}</h3><p class="stage-hint">{stage.hint}</p><div class="stage-nodes">
{stage.steps.map(i=>{const step=steps[i];return <button type="button" class="node" data-step={step.id} aria-pressed="false" aria-controls="step-detail"><span class="step-number">{i+1}</span><strong>{step.name}</strong><span class="badge" aria-hidden="true">background</span><span class="tags">{step.tag} · {step.level}</span><span class="node-count">{step.articles.length} articles</span></button>;})}
</div></section>)}
</div>
<section id="step-detail" class="detail" aria-label="Selected learning step"><h2>Choose a step</h2><p>Select a node above to explore the reading sequence.</p></section>
<noscript><p>The interactive map needs JavaScript. You can still follow the reading paths below.</p></noscript>
<details class="reading-list"><summary>View the complete reading list</summary>{steps.map((step,i)=><section><h2>{i+1}. <a href={`/series/${step.id}/`}>{step.name}</a></h2><p>{step.goal}</p><ol>{step.articles.map(article=><li><a href={article.href}>{article.title}</a></li>)}</ol></section>)}</details>
<script type="application/json" class="roadmap-data" set:html={JSON.stringify({steps,paths}).replace(/</g,'\u003c')} />
</section></main><Footer /></body></html>
<script>
function initRoadmap(){
 const root=document.querySelector<HTMLElement>('.roadmap');if(!root||root.dataset.ready)return;root.dataset.ready='true';
 type Step={id:string;name:string;level:string;goal:string;before:string[];articles:{id:string;title:string;href:string}[]};
 const {steps,paths}=JSON.parse(root.querySelector('.roadmap-data')!.textContent!) as {steps:Step[];paths:Record<string,string[]>};
 const select=root.querySelector<HTMLSelectElement>('#learning-path')!;const detail=root.querySelector<HTMLElement>('#step-detail')!;let selected=steps[0].id;
 const link=(title:string,href:string)=>{const a=document.createElement('a');a.textContent=title;a.href=href;return a;};
 function update(){
  const route=paths[select.value];
  root!.querySelector('.path-order')!.textContent=select.value==='all'?'':'Suggested order (other steps are dimmed): '+route.map(id=>steps.find(s=>s.id===id)!.name).join(' → ');
  const sel=steps.find(s=>s.id===selected)!;
  for(const step of steps){const node=root!.querySelector<HTMLButtonElement>(`[data-step="${step.id}"]`)!;node.classList.toggle('off-path',!route.includes(step.id));node.classList.toggle('prereq',sel.before.includes(step.id));node.setAttribute('aria-pressed',String(step.id===selected));}
 }
 function render(){
  const step=steps.find(s=>s.id===selected)!;detail.replaceChildren();const h=document.createElement('h2');h.textContent=step.name;detail.append(h);const goal=document.createElement('p');goal.textContent=step.goal;detail.append(goal);
  if(step.before.length){const p=document.createElement('p');p.append('Useful background: ');step.before.forEach((id,i)=>{const prior=steps.find(s=>s.id===id)!;if(i)p.append(' · ');p.append(link(prior.name,`/series/${id}/`));});detail.append(p);}
  detail.append(link('Open this series →',`/series/${step.id}/`));const list=document.createElement('ol');
  step.articles.forEach(article=>{const item=document.createElement('li');item.append(link(article.title,article.href));list.append(item);});detail.append(list);update();
 }
 root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach(node=>node.addEventListener('click',()=>{selected=node.dataset.step!;render();detail.scrollIntoView({behavior:'smooth',block:'nearest'});}));select.addEventListener('change',()=>{selected=paths[select.value][0];render();});
 render();
}
initRoadmap();document.addEventListener('astro:page-load',initRoadmap);
</script>
<style>
main{width:900px;max-width:calc(100% - 2rem)}h1{margin-bottom:.5rem}.controls{display:flex;gap:1rem;align-items:center;flex-wrap:wrap}select,button{font:inherit;color:rgb(var(--black));background:var(--bg);border:1px solid rgb(var(--gray-light));border-radius:8px;padding:.6rem;cursor:pointer}select{max-width:100%}.path-order{font-size:.75em;color:rgb(var(--gray))}.map{margin:1.5rem 0}.stage{border-left:3px solid rgba(var(--gray-light),.9);padding:0 0 .25rem 1.1rem;margin:0 0 1.6rem}.stage h3{font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;color:var(--accent);margin:0 0 .15rem}.stage-hint{font-size:.78rem;color:rgb(var(--gray));margin:0 0 .7rem}.stage-nodes{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:.8rem}.node{position:relative;display:flex;flex-direction:column;justify-content:center;text-align:left;min-height:88px;padding:.7rem .7rem .7rem 2.7rem;font-size:.72rem;box-shadow:0 3px 12px rgba(var(--gray-light),.15)}.node strong{font-size:.8rem}.node .badge{display:none;position:absolute;right:.6rem;top:.6rem;font-size:.58rem;text-transform:uppercase;letter-spacing:.05em;color:var(--accent);border:1px dashed var(--accent);border-radius:20px;padding:.1rem .45rem}.node.prereq .badge{display:inline-block}.node.prereq{border:1px dashed var(--accent)}.legend-chip{font-size:.7em;text-transform:uppercase;letter-spacing:.05em;color:var(--accent);border:1px dashed var(--accent);border-radius:20px;padding:.05rem .45rem;white-space:nowrap}.step-number{position:absolute;left:.75rem;top:.7rem;color:var(--accent);font-size:1rem;font-weight:700}.tags{font-size:.6rem;color:rgb(var(--gray));margin:.3rem 0}.node-count{font-size:.65rem;color:var(--accent)}.node[aria-pressed="true"]{border:2px solid var(--accent)}.node.off-path{opacity:.5}.detail{border:1px solid rgb(var(--gray-light));border-radius:12px;padding:1.5rem;margin:1rem 0}.detail h2{font-size:1.4rem}.detail :global(li){margin:.7rem 0;font-size:.85em}.detail :global(ol){padding-left:1.4rem}.reading-list{margin:2rem 0}.reading-list summary{cursor:pointer;color:var(--accent)}.reading-list h2{font-size:1.2rem}.reading-list li{font-size:.85em;margin:.5rem 0}[hidden]{display:none!important}button:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(max-width:650px){.stage-nodes{grid-template-columns:1fr}.stage{padding-left:.8rem}.detail{padding:1rem}}
</style>
