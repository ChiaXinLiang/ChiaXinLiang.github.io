---
import { Image } from 'astro:assets';
import 'katex/dist/katex.min.css';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SeriesSidebar from '../components/SeriesSidebar.astro';
import ArticleVisuals from '../components/ArticleVisuals.astro';

type NavLink = { href: string; title: string };
type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & {
	currentId?: string;
	readingMinutes?: number;
	prev?: NavLink;
	next?: NavLink;
	headings?: Heading[];
};

const { series, currentId, title, description, pubDate, updatedDate, linkedinDate, heroImage, readingMinutes, prev, next, headings } =
	Astro.props;
const toc = (headings ?? []).filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
            main.with-series { width: auto; max-width: 1160px; margin: auto; padding: 2rem 1rem; display: grid; gap: 2rem; }
            article { min-width: 0; }
            .with-series .prose { box-sizing: border-box; width: 100%; max-width: 760px; }
            @media (min-width: 1100px) { main.with-series { grid-template-columns: 280px minmax(0, 1fr); } }
            @media (max-width: 1099px) { main.with-series { max-width: 800px; gap: 1rem; } }
            @media (max-width: 720px) { main.with-series { padding: 1rem; } .with-series .prose { padding: 1rem 0; max-width: 100%; } }
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.toc {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1em 1.4em;
		margin: 0 0 2.5em;
		background: rgba(var(--gray-light), 0.25);
		font-size: 0.9em;
	}
	.toc-title {
		font-weight: 700;
		color: rgb(var(--black));
		margin-bottom: 0.5em;
	}
	.toc ol {
		margin: 0;
		padding-left: 1.4em;
	}
	.toc li {
		margin-bottom: 0.3em;
	}
	.toc a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.linkedin-date {
		font-size: 0.8em;
		color: rgb(var(--gray));
		margin-top: 0.3em;
	}
	.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main class:list={{ "with-series": series && currentId }}>
			{series && currentId && <SeriesSidebar seriesId={series} currentId={currentId} />}
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<span>Published <FormattedDate date={pubDate} /></span>
							{readingMinutes && <span> · {readingMinutes} min read</span>}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						<hr />
					</div>
					<ArticleVisuals />
					{
						showToc && (
							<nav class="toc">
								<div class="toc-title">In this article</div>
								<ol>
									{toc.map((h) => (
										<li>
											<a href={`#${h.slug}`}>{h.text}</a>
										</li>
									))}
								</ol>
							</nav>
						)
					}
					<div class="article-content"><slot /></div>
					{
						(prev || next) && (
							<nav class="post-nav">
								{prev ? (
									<a class="nav-card prev" href={prev.href}>
										<span class="dir">← Previous</span>
										<span class="nav-title">{prev.title}</span>
									</a>
								) : (
									<span />
								)}
								{next ? (
									<a class="nav-card next" href={next.href}>
										<span class="dir">Next →</span>
										<span class="nav-title">{next.title}</span>
									</a>
								) : (
									<span />
								)}
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-nav {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 3rem;
		border-top: 1px solid rgb(var(--gray-light));
		padding-top: 1.5rem;
	}
	.nav-card {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		padding: 0.9rem 1.1rem;
		text-decoration: none;
		transition: box-shadow 0.2s ease;
	}
	.nav-card:hover {
		box-shadow: var(--box-shadow);
	}
	.nav-card.next {
		text-align: right;
	}
	.dir {
		font-size: 0.8em;
		font-weight: 700;
		color: var(--accent);
	}
	.nav-title {
		font-size: 0.95em;
		color: rgb(var(--gray-dark));
	}
	@media (max-width: 720px) {
		.post-nav {
			grid-template-columns: 1fr;
		}
		.nav-card.next {
			text-align: left;
		}
	}
</style>

<style is:global>
.prose .katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.5em 0; }
.prose .katex { font-size: 1.05em; }
</style>
